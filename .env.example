# Copy to .env and adjust. All settings use the KTI_ prefix.
KTI_DATABASE_URL=postgresql+psycopg://kti:kti_dev_password@localhost:5432/kti

# Traffic levels (extra delay in minutes on a road) - SRS section 4.3.2
KTI_FREE_FLOW_MAX_DELAY=2
KTI_MODERATE_MAX_DELAY=7
KTI_HEAVY_MAX_DELAY=15

# Automatic alert threshold (used from slice 5)
KTI_ALERT_DELAY_THRESHOLD=10

# Simulation: run the simulator inside the web app (handy for demos)
KTI_SIMULATION_AUTORUN=false
KTI_SIMULATION_SCENARIO=auto
KTI_SIMULATION_INTERVAL_SECONDS=60
